---
// About = full Bio, every paragraph (L2 / D10).
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, paragraphs } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout title={`เกี่ยวกับผม · ${profile.name}`} description={profile.headline}>
  <article class="card">
    <h1>เกี่ยวกับผม</h1>
    {paragraphs(profile.bio).map((p) => <p>{p}</p>)}
    <p><a href="/contact">ทักมาคุยกัน →</a></p>
  </article>
</BaseLayout>
