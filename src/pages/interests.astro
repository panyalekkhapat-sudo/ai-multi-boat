---
// Interests = `ชื่อ — เหตุผล` items (D7) · no per-card "talk about this" link (single CTA).
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, splitInterest } from '../lib/profile';
const profile = loadProfile();
const items = profile.interests.map(splitInterest);
---
<BaseLayout title={`สิ่งที่สนใจ · ${profile.name}`} description={profile.headline}>
  <section class="card">
    <h1>สิ่งที่สนใจ</h1>
    <ul class="interests">
      {items.map((item) => (
        <li>
          <h2>{item.title}</h2>
          {item.reason && <p>{item.reason}</p>}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .interests { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .interests li { border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; }
  .interests h2 { font-size: 1.1rem; margin: 0; }
  .interests p { margin: 0.35rem 0 0; }
</style>
