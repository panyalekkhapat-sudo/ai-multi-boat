---
// Home = Name + Headline (D1) + Tagline (D2) + one CTA (D4). No audience chips.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout title={profile.name} description={profile.headline}>
  <section class="card hero">
    <p class="eyebrow">{profile.name}</p>
    <h1>{profile.headline}</h1>
    {profile.tagline && <p class="lead">{profile.tagline}</p>}
    <p><a class="btn" href="/contact">ทักมาคุยกัน</a></p>
    <p class="muted-note">รับคุยเรื่องร่วมทีม · โปรเจกต์ · เริ่มเรียนเขียนเว็บ</p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3rem 2rem; }
  .hero .btn { margin-top: 0.5rem; }
</style>
