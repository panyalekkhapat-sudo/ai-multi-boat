---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Guestbook">
  <section class="card">
    <h1>Guestbook</h1>
    <p>ฝากข้อความทักทายไว้ได้ที่นี่ครับ</p>
    <form id="gb-form">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" />
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <p style="margin-top:1rem"><button type="submit">Sign</button></p>
      <p id="gb-status" role="status" aria-live="polite"></p>
    </form>
    <div id="entries" class="card" style="margin-top:1.25rem" aria-live="polite">Loading…</div>
  </section>
</BaseLayout>
<script>
  const entries = document.getElementById('entries');
  const form = document.getElementById('gb-form') as HTMLFormElement | null;
  const status = document.getElementById('gb-status');
  const LOAD_ERROR_MSG = 'ตอนนี้โหลดข้อความไม่ได้ ลองใหม่อีกครั้งภายหลังครับ';
  const EMPTY_MSG = 'ยังไม่มีข้อความ';
  const SUCCESS_MSG = 'บันทึกแล้ว ขอบคุณครับ';
  const INPUT_MSG = 'กรุณาตรวจชื่อและข้อความอีกครั้ง';
  const FALLBACK_MSG = 'ตอนนี้ส่งไม่ได้ — ข้อความของคุณยังอยู่ ลองใหม่อีกครั้งภายหลังครับ';

  type Entry = { id: number; name: string; message: string; created_at: string };

  function setStatus(text: string) {
    if (status) status.textContent = text;
  }

  function showText(text: string) {
    if (!entries) return;
    const p = document.createElement('p');
    p.textContent = text;
    entries.replaceChildren(p);
  }

  function render(list: Entry[]) {
    if (!entries) return;
    if (list.length === 0) {
      showText(EMPTY_MSG);
      return;
    }
    const nodes = list.map((e) => {
      const p = document.createElement('p');
      const strong = document.createElement('strong');
      strong.textContent = String(e.name ?? '');
      const small = document.createElement('small');
      small.textContent = String(e.created_at ?? '');
      // append(string) creates a Text node — user data is never parsed as HTML.
      p.append(strong, ': ' + String(e.message ?? ''), document.createElement('br'), small);
      return p;
    });
    entries.replaceChildren(...nodes);
  }

  async function load() {
    try {
      const res = await fetch('/api/guestbook');
      if (!res.ok) {
        showText(LOAD_ERROR_MSG);
        return;
      }
      const data = await res.json();
      render(Array.isArray(data?.entries) ? data.entries : []);
    } catch {
      showText(LOAD_ERROR_MSG);
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    setStatus('Sending…');
    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        setStatus(res.status === 400 ? INPUT_MSG : FALLBACK_MSG);
        return;
      }
      setStatus(SUCCESS_MSG);
      form.reset();
      await load();
    } catch {
      setStatus(FALLBACK_MSG);
    }
  });

  load();
</script>
